<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="json-inspector.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Yuri Gerasimov\JSON Inspector">
    </Installer>
    <PackageInformation
        PackageName="JSON Inspector"
        PackageDisplayName="JSON Inspector"
        PublisherName="CN=Yuri Gerasimov"
        PublisherDisplayName="Yuri Gerasimov"
        Version="0.1.0.0"
        PackageDescription="A json-inspector application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jurager.json-inspector"
                Description="A json-inspector application"
                DisplayName="JSON Inspector"
                ExecutableName="json-inspector.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>JSON Inspector</DisplayName>
            <PublisherDisplayName>Yuri Gerasimov</PublisherDisplayName>
            <Description>A json-inspector application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="json-inspector.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
